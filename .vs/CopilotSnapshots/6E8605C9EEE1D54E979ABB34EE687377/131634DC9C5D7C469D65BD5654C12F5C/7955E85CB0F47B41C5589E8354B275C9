using Microsoft.EntityFrameworkCore;
using System.Globalization;
using TarjetaSUBE;

namespace MasSobreElBoletoTest
{
    public class MasSobreElBoleto
    {
        private TarjetaSUBEContext _db = null!;
        private Tarjeta_tipo[] _tipos = null!;
        private Colectivo _colectivo = null!;

        [SetUp]
        public void Setup()
        {
            var opciones = new DbContextOptionsBuilder<TarjetaSUBEContext>()
                .UseInMemoryDatabase(Guid.NewGuid().ToString())
                .Options;

            _db = new TarjetaSUBEContext(opciones);
            Contexto.Db = _db;

            _tipos =
            [
                new Tarjeta_tipo { id_Tipo = 1, nombre_Tipo = "Tarifa general", porcentaje_pago = 100 },
                new Tarjeta_tipo { id_Tipo = 2, nombre_Tipo = "Medio boleto estudiantil", porcentaje_pago = 50 },
                new Tarjeta_tipo { id_Tipo = 3, nombre_Tipo = "Boleto gratuito estudiantil", porcentaje_pago = 0 },
                new Tarjeta_tipo { id_Tipo = 4, nombre_Tipo = "Franquicia completa", porcentaje_pago = 0 }
            ];
            _db.Tarjeta_tipos.AddRange(_tipos);
            _colectivo = new Colectivo { Linea = "123", Matricula = "ABC 123" };
            _db.Colectivos.Add(_colectivo);
            _db.SaveChanges();
        }

        [TearDown]
        public void TearDown()
        {
            _db.Dispose();
        }

        [Test]
        [TestCase(1, "Tarifa general", 2150, -150)]
        [TestCase(2, "Medio boleto estudiantil", 2150, 925)]
        [TestCase(3, "Boleto gratuito estudiantil", 2150, 2000)]
        [TestCase(4, "Franquicia completa", 2150, 2000)]
        public void BoletoInformaDatosSegunTipoDeTarjeta(int tipoId, string nombreTipo, int totalAbonado, int saldoRestante)
        {
            var tarjeta = new Tarjeta(2000, tipoId)
            {
                tarjeta_tipo = tipoId,
                Tipo = _tipos.Single(tipo => tipo.id_Tipo == tipoId)
            };

            if (tipoId == 2)
            {
                tarjeta.fecha_ultimo_cobro = DateTime.Now.AddMinutes(-6);
            }

            Assert.That(_colectivo.pagarCon(tarjeta), Is.SameAs(tarjeta));

            var boleto = _db.Boletos.Single();

            Assert.That(DateTime.TryParseExact(
                boleto.Return_Fecha(),
                "yyyy-MM-dd HH:mm:ss",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out _), Is.True);
            Assert.That(boleto.Return_Tipo_Tarjeta(), Is.EqualTo(nombreTipo));
            Assert.That(boleto.Return_Linea(), Is.EqualTo(_colectivo.Linea));
            Assert.That(boleto.Return_Total_Abonado(), Is.EqualTo(tipoId == 2 ? totalAbonado / 2 : tipoId >= 3 ? 0 : totalAbonado));
            Assert.That(boleto.Return_Saldo_Restante(), Is.EqualTo(saldoRestante));
            Assert.That(boleto.Return_ID_Tarjeta(), Is.EqualTo(tarjeta.IdTarjeta));
            Assert.That(tarjeta.Saldo, Is.EqualTo(saldoRestante));
        }

        [Test]
        [TestCase(1, 2150, -2000)]
        [TestCase(2, 1075, -925)]
        [TestCase(3, 0, 150)]
        [TestCase(4, 0, 150)]
        public void CobrarIncluyeDeudaPreviaEnDebito(int tipoId, int montoDebitado, int saldoEsperado)
        {
            var tarjeta = new Tarjeta(150, tipoId)
            {
                tarjeta_tipo = tipoId,
                Tipo = _tipos.Single(tipo => tipo.id_Tipo == tipoId)
            };

            if (tipoId == 2)
            {
                tarjeta.fecha_ultimo_cobro = DateTime.Now.AddMinutes(-6);
            }

            Assert.That(_colectivo.pagarCon(tarjeta), Is.SameAs(tarjeta));

            var boleto = _db.Boletos.Single();

            Assert.That(boleto.Return_Total_Abonado(), Is.EqualTo(tipoId == 2 ? 1075 : tipoId >= 3 ? 0 : 2150));
            Assert.That(boleto.Return_Tipo_Tarjeta(), Is.EqualTo(tarjeta.Tipo.nombre_Tipo));
            Assert.That(150 - tarjeta.Saldo, Is.EqualTo(montoDebitado));
            Assert.That(boleto.Return_Saldo_Restante(), Is.EqualTo(saldoEsperado));
            Assert.That(tarjeta.Saldo, Is.EqualTo(saldoEsperado));
        }

        [Test]
        [TestCase(1)]
        [TestCase(2)]
        [TestCase(3)]
        [TestCase(4)]
        public void NoBoletoCuandoSaldoEsMenorALimiteDeViaje(int tipoId)
        {
            var tarjeta = new Tarjeta(-501, tipoId)
            {
                tarjeta_tipo = tipoId,
                Tipo = _tipos.Single(tipo => tipo.id_Tipo == tipoId)
            };

            if (tipoId <= 2)
            {
                Assert.That(() => _colectivo.pagarCon(tarjeta), Throws.Exception);
            }
            else
            {
                Assert.That(_colectivo.pagarCon(tarjeta), Is.SameAs(tarjeta));
            }
            Assert.That(_db.Boletos, Is.Empty);
            Assert.That(tarjeta.Saldo, Is.EqualTo(-501));
        }

        [Test]
        [TestCase(1, true, -500, 0)]
        [TestCase(2, false, -1575, 1)]
        [TestCase(3, false, -500, 1)]
        [TestCase(4, false, -500, 1)]
        public void CobrarFallaSiDebitoSuperaLimiteNegativo(int tipoId, bool superaLimite, int saldoEsperado, int boletosEsperados)
        {
            var tarjeta = new Tarjeta(-500, tipoId)
            {
                tarjeta_tipo = tipoId,
                Tipo = _tipos.Single(tipo => tipo.id_Tipo == tipoId)
            };

            if (tipoId == 2)
            {
                tarjeta.fecha_ultimo_cobro = DateTime.Now.AddMinutes(-6);
            }

            if (superaLimite)
            {
                Assert.That(() => _colectivo.pagarCon(tarjeta), Throws.TypeOf<ArgumentException>());
            }
            else
            {
                Assert.That(_colectivo.pagarCon(tarjeta), Is.SameAs(tarjeta));
            }

            Assert.That(_db.Boletos.Count(), Is.EqualTo(boletosEsperados));
            Assert.That(tarjeta.Saldo, Is.EqualTo(saldoEsperado));
            if (boletosEsperados > 0)
            {
                Assert.That(_db.Boletos.Single().Return_Saldo_Restante(), Is.EqualTo(saldoEsperado));
            }
        }
    }
}
using System;
using System.ComponentModel.DataAnnotations;
using System.Reflection.Metadata.Ecma335;

namespace TarjetaSUBE
{
    public class Tarjeta
    {
        private const decimal LIMITE_SUPERIOR = 56000m;
        public decimal Saldo; //límite 40k
        public int IdTarjeta;
        public int tarjeta_tipo; // 1.Normal (100%), 2.Medio Boleto Estudiantil (50%), 3.Boleto Gratuito Estudiantil (0%), 4.Franquicia Completa (0%)
        public DateTime fecha_ultimo_cobro = Contexto.Reloj();
        public int CantidadViajes_Dia;
        public Tarjeta_tipo Tipo { get; set; }
        public decimal Excedente;

        public Tarjeta() { }

        public Tarjeta(decimal saldo, int tipo)
        {
            if (saldo > LIMITE_SUPERIOR)
            {
                throw new ArgumentException("El saldo no puede superar los 40.000");
            }
            else if (saldo < -2000m)
            {
                throw new ArgumentException("El saldo no puede ser menor a -2000");
            }
            else
            {
                Saldo = saldo;
                tarjeta_tipo = tipo;
                Excedente = 0;
                Contexto.Db.Tarjetas.Add(this);
                Contexto.Db.SaveChanges();
            }
        }

        public Tarjeta Cargar(decimal monto)
        {
            if (monto < 0)
            {
                throw new ArgumentException("El monto no puede ser negativo");
            } else if (!new decimal[] { 2000m, 3000m, 4000m, 5000m, 8000m, 10000m, 15000m, 20000m, 25000m, 30000m }.Contains(monto)) {
                throw new ArgumentException("El monto debe ser uno de los siguientes: 2000, 3000, 4000, 5000, 8000, 10000, 15000, 20000, 25000, 30000");
            }
            else
            {
                Excedente += monto;
                this.Acreditar();
                return this;
            }

        }

        public Tarjeta Acreditar()
        {
            if (Excedente + Saldo <= LIMITE_SUPERIOR)
            {
                Saldo += Excedente;
                Excedente = 0;
                Contexto.Db.SaveChanges();
            }
            else
            {
                Excedente = (Excedente + Saldo) - LIMITE_SUPERIOR;
                Saldo = LIMITE_SUPERIOR;
                Contexto.Db.SaveChanges();
            }
            return this;
        }

        public Tarjeta Cobrar_Bici(decimal monto)
        {
            Saldo -= monto;
            Contexto.Db.SaveChanges();
            return this;
        }

        public Tarjeta Cobrar(decimal monto)
        {
            return CobrarInterno(monto, null);
        }

        public Tarjeta Cobrar(decimal monto, Colectivo colectivo)
        {
            return CobrarInterno(monto, colectivo);
        }

        private Tarjeta CobrarInterno(decimal monto, Colectivo? colectivo)
        {
            var ahora = Contexto.Reloj();
            TimeSpan diferencia = ahora - fecha_ultimo_cobro;
            int cantidad = Contexto.Db.Boletos
            .Where(b => b.Tarjeta.IdTarjeta == this.IdTarjeta && b.Fecha.StartsWith(ahora.ToString("yyyy-MM-dd")))
            .Count();

            var boletosTarjeta = Contexto.Db.Boletos
                .Where(b => b.Tarjeta.IdTarjeta == this.IdTarjeta)
                .ToArray();
            var ultimoBoleto = boletosTarjeta
                .OrderByDescending(b => b.Fecha)
                .FirstOrDefault();
            var primerBoleto = boletosTarjeta
                .Where(b => b.es_Trasbordo == 0)
                .OrderByDescending(b => b.Fecha)
                .FirstOrDefault();
            bool dentroDeLaHora = primerBoleto != null
                && DateTime.TryParseExact(
                    primerBoleto.Fecha,
                    "yyyy-MM-dd HH:mm:ss",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None,
                    out var fechaPrimerBoleto)
                && ahora >= fechaPrimerBoleto
                && ahora - fechaPrimerBoleto < TimeSpan.FromHours(1);
            bool dentroDelHorario = ahora.DayOfWeek >= DayOfWeek.Monday
                && ahora.DayOfWeek <= DayOfWeek.Saturday
                && ahora.TimeOfDay >= TimeSpan.FromHours(7)
                && ahora.TimeOfDay <= TimeSpan.FromHours(22);

            if (colectivo != null
                && ultimoBoleto != null
                && dentroDelHorario
                && dentroDeLaHora
                && ultimoBoleto.Colectivo.Linea != colectivo.Linea)
            {
                RegistrarBoleto(colectivo, 0, true);
                fecha_ultimo_cobro = ahora;
                return this;
            }
            else
            {
                //Boleto Estudiantil Gratuito
                if (this.Tipo.nombre_Tipo == "Boleto gratuito estudiantil")
                {
                    if (cantidad < 2)
                    {
                        // no se resta nada
                        Contexto.Db.SaveChanges();
                        RegistrarBoleto(colectivo, 0, false);
                        fecha_ultimo_cobro = ahora;
                        return this;
                    }
                    else
                    {
                        Saldo -= monto;
                        Contexto.Db.SaveChanges();
                        RegistrarBoleto(colectivo, monto, false);
                        fecha_ultimo_cobro = ahora;
                        return this;
                    }
                }
                // Boleto Franquicia Completa (Jubilados)
                if (this.Tipo.nombre_Tipo == "Franquicia completa")
                {
                    if (diferencia.TotalMinutes < 5)
                    {
                        //no se resta nada
                        Contexto.Db.SaveChanges();
                        RegistrarBoleto(colectivo, 0, false);
                        fecha_ultimo_cobro = ahora;
                        return this;
                    }
                    else
                    {
                        throw new Exception("EL JUBILADO PAGO HACE MENOS DE 5 MINUTOS");
                    }
                }

                // Boleto Estudiantil Medio
                if (this.Tipo.nombre_Tipo == "Medio boleto estudiantil")
                {
                    if (diferencia.TotalMinutes < 5)
                    {
                        throw new Exception("No se puede cobrar el viaje, ya que no han pasado 5 minutos desde el último cobro de medio boleto");
                    }
                    else
                    {
                        Saldo -= (monto / 2);
                        Contexto.Db.SaveChanges();
                        RegistrarBoleto(colectivo, monto / 2, false);
                        fecha_ultimo_cobro = ahora;
                        return this;
                    }
                }
                if (Saldo - monto < -2000m)
                {
                    throw new ArgumentException("El saldo no puede ser menor a -2000");
                }
                else
                {
                    Saldo -= monto;
                    Contexto.Db.SaveChanges();
                    RegistrarBoleto(colectivo, monto, false);
                    fecha_ultimo_cobro = ahora;
                    return this;
                }
            }
        }

        private void RegistrarBoleto(Colectivo? colectivo, decimal monto, bool trasbordo)
        {
            if (colectivo != null)
            {
                new Boleto(this, colectivo, monto, trasbordo, Contexto.Reloj());
            }
        }
    }
}

using System;

namespace TarjetaSUBE
{
    public class Colectivo
    {
        private const decimal PRECIO_URBANO = 2150m;
        private const decimal PRECIO_INTERURBANO = 3000m;
        public int IdColectivo;
        public required string Linea;
        public required string Matricula;
        public int interurbano; // 0 = urbano, 1 = interurbano

        public Colectivo() { }

        public bool pagarCon(Tarjeta tarjeta)
        {
            if (tarjeta.Saldo < -500m)
            {
                return false;
            }

            if (interurbano == 1)
            {
                tarjeta.Cobrar(PRECIO_INTERURBANO, this);
                return true;
            }
            if (interurbano == 0)
            {
                tarjeta.Cobrar(PRECIO_URBANO, this);
                return true;
            }
            return false;
        }

    }
}

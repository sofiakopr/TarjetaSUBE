using Microsoft.EntityFrameworkCore;
using TarjetaSUBE;

namespace HorarioFranquiciaTest
{
    public class Tests
    {
        private TarjetaSUBEContext _db = null!;
        private Tarjeta_tipo[] _tipos = null!;
        private Tarjeta[] _tarjetas = null!;

        [SetUp]
        public void Setup()
        {
            var opciones = new DbContextOptionsBuilder<TarjetaSUBEContext>()
                .UseInMemoryDatabase(Guid.NewGuid().ToString())
                .Options;

            _db = new TarjetaSUBEContext(opciones);
            Contexto.Db = _db;

            _tipos =
            [
                new Tarjeta_tipo { id_Tipo = 1, nombre_Tipo = "Tarifa general", porcentaje_pago = 100 },
                new Tarjeta_tipo { id_Tipo = 2, nombre_Tipo = "Medio boleto estudiantil", porcentaje_pago = 50 },
                new Tarjeta_tipo { id_Tipo = 3, nombre_Tipo = "Boleto gratuito estudiantil", porcentaje_pago = 0 },
                new Tarjeta_tipo { id_Tipo = 4, nombre_Tipo = "Franquicia completa", porcentaje_pago = 0 }
            ];
            _db.Tarjeta_tipos.AddRange(_tipos);
            _db.SaveChanges();

            _tarjetas = _tipos
                .Select(tipo => new Tarjeta(0, tipo.id_Tipo) { Tipo = tipo })
                .ToArray();
        }

        [TearDown]
        public void TearDown()
        {
            _db.Dispose();
        }

        [Test]
        [TestCase(1, 5, 59, true, 1580)]
        [TestCase(1, 6, 0, true, 1580)]
        [TestCase(1, 21, 59, true, 1580)]
        [TestCase(1, 22, 0, true, 1580)]
        [TestCase(2, 5, 59, false, 0)]
        [TestCase(2, 6, 0, true, 790)]
        [TestCase(2, 21, 59, true, 790)]
        [TestCase(2, 22, 0, false, 0)]
        [TestCase(3, 5, 59, false, 0)]
        [TestCase(3, 6, 0, true, 0)]
        [TestCase(3, 21, 59, true, 0)]
        [TestCase(3, 22, 0, false, 0)]
        [TestCase(4, 5, 59, false, 0)]
        [TestCase(4, 6, 0, true, 0)]
        [TestCase(4, 21, 59, true, 0)]
        [TestCase(4, 22, 0, false, 0)]
        public void CobrarAplicaElHorarioDeBeneficioSegunTipoDeTarjeta(
            int tipoId,
            int hora,
            int minuto,
            bool pagoPermitido,
            int montoDebitado)
        {
            var tarjeta = _tarjetas.Single(tarjeta => tarjeta.tarjeta_tipo == tipoId);
            tarjeta.Cargar(2000);

            var fechaActual = new DateTime(2026, 1, 15, hora, minuto, 0);
            if (tipoId == 2)
            {
                tarjeta.fecha_ultimo_cobro = fechaActual.AddMinutes(-6);
            }
            else if (tipoId == 4)
            {
                tarjeta.fecha_ultimo_cobro = fechaActual;
            }

            if (pagoPermitido)
            {
                tarjeta.Cobrar(1580, fechaActual);
                Assert.That(tarjeta.Saldo, Is.EqualTo(2000 - montoDebitado));
            }
            else
            {
                var exception = Assert.Throws<Exception>(() => tarjeta.Cobrar(1580, fechaActual));

                Assert.That(exception!.Message, Is.EqualTo("No se puede cobrar el viaje, ya que no es horario de servicio (6:00 a 22:00)"));
                Assert.That(tarjeta.Saldo, Is.EqualTo(2000));
            }
        }
    }
}
